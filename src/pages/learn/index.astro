---
import Layout from '../../components/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Learn Numerology - Numero Girija">
    <div class="hero-section">
        <h1>Lo Shu Grid Learning Portal</h1>
        <p>Master numerology at your own pace with our comprehensive educational library</p>
    </div>

    <div class="categories-grid">
        <a href={`${base}learn/basics/`} class="category-card basics">
            <div class="icon">📚</div>
            <h2>Grid Basics</h2>
            <p>Understand Lo Shu Grid fundamentals and how to create your chart</p>
            <span class="topics-count">3 Topics</span>
        </a>

        <a href={`${base}learn/numbers/`} class="category-card numbers">
            <div class="icon">🔢</div>
            <h2>Numbers 1-9</h2>
            <p>Deep dive into meanings, characteristics, and influences of each number</p>
            <span class="topics-count">4 Topics</span>
        </a>

        <a href={`${base}learn/remedies/`} class="category-card remedies">
            <div class="icon">💎</div>
            <h2>Remedies & Solutions</h2>
            <p>Gemstones, mantras, and lifestyle guidance for missing numbers</p>
            <span class="topics-count">3 Topics</span>
        </a>

        <a href={`${base}learn/relationships/`} class="category-card relationships">
            <div class="icon">❤️</div>
            <h2>Compatibility</h2>
            <p>Learn about relationship dynamics and name numerology</p>
            <span class="topics-count">3 Topics</span>
        </a>

        <a href={`${base}learn/advanced/`} class="category-card advanced">
            <div class="icon">🎓</div>
            <h2>Advanced Concepts</h2>
            <p>Planes, arrows, yearly cycles, and prediction methods</p>
            <span class="topics-count">3 Topics</span>
        </a>

        <a href={`${base}learn/name-numerology/`} class="category-card name-num">
            <div class="icon">📝</div>
            <h2>Name Numerology</h2>
            <p>Calculate name numbers, understand systems, and learn name correction</p>
            <span class="topics-count">Complete Guide</span>
        </a>
    </div>

    <style>
        .hero-section {
            text-align: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #2d1b69 0%, #6b3fa0 100%);
            border-radius: 20px;
            margin-bottom: 30px;
            color: white;
        }

        .hero-section h1 {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 12px;
            letter-spacing: -1px;
        }

        .hero-section p {
            font-size: 1rem;
            opacity: 0.95;
            line-height: 1.6;
        }

        .categories-grid {
            display: grid;
            gap: 20px;
            margin-bottom: 30px;
        }

        @media (min-width: 768px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 1024px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .category-card {
            display: block;
            background: white;
            border: 2px solid #e8e8e8;
            border-radius: 16px;
            padding: 28px 24px;
            text-decoration: none;
            color: inherit;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .category-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #2d1b69 0%, #6b3fa0 100%);
            transform: scaleX(0);
            transition: transform 0.3s;
        }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
            border-color: #6b3fa0;
        }

        .category-card:hover::before {
            transform: scaleX(1);
        }

        .category-card .icon {
            font-size: 3rem;
            margin-bottom: 16px;
        }

        .category-card h2 {
            color: #2d1b69;
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .category-card p {
            color: #666;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 16px;
        }

        .topics-count {
            display: inline-block;
            background: #f3f4f6;
            color: #6b3fa0;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
</Layout>
