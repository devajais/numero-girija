---
import Layout from '../../../components/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Personal Numbers Explained - Numero Girija">
    <div id="personalSection"></div>

    <div class="card">
        <h2 class="section-title">Understanding Personal Numbers</h2>
        <p style="color: #666; font-size: 0.9rem; line-height: 1.6;">
            Your Lo Shu Grid reveals three critical numbers that shape your life journey: Driver, Conductor, and Personal Year. Each plays a unique role in your personality and destiny.
        </p>
    </div>

    <div class="card">
        <div style="background: linear-gradient(135deg, #f0f9ff, #e0f2fe); padding: 20px; border-radius: 16px; border-left: 4px solid #3b82f6; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700;">1</div>
                <div>
                    <h3 style="color: #3b82f6; font-size: 1.2rem; margin-bottom: 5px; font-weight: 700;">Driver Number</h3>
                    <p style="color: #666; font-size: 0.8rem;">Your Personality & Natural Tendencies</p>
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">📌 What is it?</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6;">
                    The Driver number is calculated from your birth <strong>day only</strong>. It represents your core personality, natural behavior, and how you approach life intuitively.
                </p>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🧮 Calculation</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6; margin-bottom: 8px;">
                    Add digits of your birth day until you get a single digit:
                </p>
                <div style="background: linear-gradient(135deg, #f9f5ff, #f0ebff); padding: 12px; border-radius: 8px; font-family: monospace; font-size: 0.85rem;">
                    Example: Born on 23rd<br>
                    2 + 3 = <strong style="color: #3b82f6; font-size: 1.1rem;">5</strong><br>
                    Driver Number = 5
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🎯 What it reveals</h4>
                <ul style="list-style: none; padding: 0; display: grid; gap: 6px;">
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #3b82f6;">•</span>
                        Your natural personality and behavior
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #3b82f6;">•</span>
                        How you instinctively react to situations
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #3b82f6;">•</span>
                        Your strengths and natural talents
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #3b82f6;">•</span>
                        Most active until age 35-40
                    </li>
                </ul>
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); padding: 20px; border-radius: 16px; border-left: 4px solid #33cc33; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #33cc33, #22bb33); color: white; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700;">2</div>
                <div>
                    <h3 style="color: #33cc33; font-size: 1.2rem; margin-bottom: 5px; font-weight: 700;">Conductor Number</h3>
                    <p style="color: #666; font-size: 0.8rem;">Your Destiny & Life Path</p>
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">📌 What is it?</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6;">
                    The Conductor number is calculated from your <strong>complete date of birth</strong>. It represents your destiny, life purpose, and the path you're meant to follow.
                </p>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🧮 Calculation</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6; margin-bottom: 8px;">
                    Add ALL digits from day, month, and year:
                </p>
                <div style="background: linear-gradient(135deg, #f9f5ff, #f0ebff); padding: 12px; border-radius: 8px; font-family: monospace; font-size: 0.85rem;">
                    Example: 23-05-1990<br>
                    2+3+0+5+1+9+9+0 = 29<br>
                    2+9 = 11<br>
                    1+1 = <strong style="color: #33cc33; font-size: 1.1rem;">2</strong><br>
                    Conductor Number = 2
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🎯 What it reveals</h4>
                <ul style="list-style: none; padding: 0; display: grid; gap: 6px;">
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #33cc33;">•</span>
                        Your life purpose and destiny
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #33cc33;">•</span>
                        What life is pushing you towards
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #33cc33;">•</span>
                        Your career and relationship patterns
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #33cc33;">•</span>
                        Becomes more active after age 35-40
                    </li>
                </ul>
            </div>
        </div>

        <div style="background: linear-gradient(135deg, #fef9e7, #fef3c7); padding: 20px; border-radius: 16px; border-left: 4px solid #f59e0b;">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #f59e0b, #fbbf24); color: white; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700;">3</div>
                <div>
                    <h3 style="color: #f59e0b; font-size: 1.2rem; margin-bottom: 5px; font-weight: 700;">Personal Year Number</h3>
                    <p style="color: #666; font-size: 0.8rem;">Your Current Year Energy</p>
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">📌 What is it?</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6;">
                    Your Personal Year number changes every year and reveals the specific energy and themes you'll experience during that year. It's calculated using your birth day, month, and the current year.
                </p>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px; margin-bottom: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🧮 Calculation</h4>
                <p style="color: #555; font-size: 0.85rem; line-height: 1.6; margin-bottom: 8px;">
                    Add your birth day + birth month + current year:
                </p>
                <div style="background: linear-gradient(135deg, #f9f5ff, #f0ebff); padding: 12px; border-radius: 8px; font-family: monospace; font-size: 0.85rem;">
                    Example: Born 23-05, Year 2026<br>
                    Day: 2+3 = 5<br>
                    Month: 0+5 = 5<br>
                    Year: 2+0+2+6 = 10 → 1+0 = 1<br>
                    5+5+1 = 11 → 1+1 = <strong style="color: #f59e0b; font-size: 1.1rem;">2</strong><br>
                    Personal Year 2026 = 2
                </div>
            </div>

            <div style="background: white; padding: 15px; border-radius: 12px;">
                <h4 style="color: #2d1b69; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">🎯 What it reveals</h4>
                <ul style="list-style: none; padding: 0; display: grid; gap: 6px;">
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #f59e0b;">•</span>
                        The theme and energy of the current year
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #f59e0b;">•</span>
                        What opportunities and challenges to expect
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #f59e0b;">•</span>
                        Best actions and decisions for the year
                    </li>
                    <li style="padding-left: 20px; position: relative; color: #555; font-size: 0.85rem;">
                        <span style="position: absolute; left: 0; color: #f59e0b;">•</span>
                        Part of a 9-year cycle (1-9) that repeats
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #fff5f5, #ffe5e5); border-left: 4px solid #dc2626;">
        <h3 style="color: #dc2626; font-size: 1rem; margin-bottom: 12px; font-weight: 600;">⚖️ Driver-Conductor Relationship</h3>
        <p style="color: #555; font-size: 0.85rem; line-height: 1.6; margin-bottom: 12px;">
            The relationship between your Driver and Conductor numbers is crucial:
        </p>
        <div style="display: grid; gap: 10px;">
            <div style="background: white; padding: 12px; border-radius: 10px;">
                <strong style="color: #33cc33; font-size: 0.85rem;">✓ Friendly:</strong>
                <span style="color: #666; font-size: 0.85rem;"> Harmonious life, personality and destiny support each other</span>
            </div>
            <div style="background: white; padding: 12px; border-radius: 10px;">
                <strong style="color: #f59e0b; font-size: 0.85rem;">~ Neutral:</strong>
                <span style="color: #666; font-size: 0.85rem;"> Balanced energy, requires conscious effort</span>
            </div>
            <div style="background: white; padding: 12px; border-radius: 10px;">
                <strong style="color: #dc2626; font-size: 0.85rem;">⚠ Opposite:</strong>
                <span style="color: #666; font-size: 0.85rem;"> Internal conflicts but potential for great growth</span>
            </div>
        </div>
    </div>

    <div class="card" style="text-align: center; background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
        <p style="color: #666; font-size: 0.85rem; margin-bottom: 15px;">Ready to discover your personal numbers?</p>
        <a href={`${base}grid/`} class="btn">Calculate My Numbers</a>
    </div>

    <script is:inline define:vars={{ base }}>
        const script = document.createElement('script');
        script.src = base + 'loshu-utils.js';
        document.head.appendChild(script);
    </script>
    <script is:inline define:vars={{ base }}>
        const dob = sessionStorage.getItem('userDOB');
        if (dob) {
            const data = calculateLoShuChart(dob);
            const universalYear = calculateUniversalYear(2026);
            const personalYear = calculatePersonalYear(data.day, data.month, universalYear);

            document.getElementById('personalSection').innerHTML = `
                <div class="card" style="background: linear-gradient(135deg, #f9f5ff, #f0ebff); border-left: 4px solid #6b3fa0;">
                    <h2 style="color: #6b3fa0; font-size: 1.2rem; margin-bottom: 15px; font-weight: 700;">
                        Your Personal Numbers
                    </h2>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 15px;">
                        <div style="background: white; padding: 15px; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.7rem; color: #666; margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">Driver</div>
                            <div style="font-size: 2rem; font-weight: 700; color: #3b82f6; margin-bottom: 4px;">${data.driver}</div>
                            <div style="font-size: 0.7rem; color: #666;">Personality</div>
                        </div>
                        <div style="background: white; padding: 15px; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.7rem; color: #666; margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">Conductor</div>
                            <div style="font-size: 2rem; font-weight: 700; color: #33cc33; margin-bottom: 4px;">${data.conductor}</div>
                            <div style="font-size: 0.7rem; color: #666;">Destiny</div>
                        </div>
                        <div style="background: white; padding: 15px; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.7rem; color: #666; margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">Personal Year</div>
                            <div style="font-size: 2rem; font-weight: 700; color: #f59e0b; margin-bottom: 4px;">${personalYear}</div>
                            <div style="font-size: 0.7rem; color: #666;">2026</div>
                        </div>
                    </div>

                    <div style="background: white; padding: 15px; border-radius: 12px;">
                        <h4 style="color: #6b3fa0; font-size: 0.9rem; margin-bottom: 8px; font-weight: 600;">Your Combination</h4>
                        <p style="color: #555; font-size: 0.85rem; line-height: 1.6;">
                            You have a Driver ${data.driver} and Conductor ${data.conductor} combination.
                            Your Personal Year for 2026 is ${personalYear}.
                        </p>
                        <div style="margin-top: 12px;">
                            <a href="${base}compatibility/" class="btn" style="font-size: 0.85rem; padding: 10px 16px;">
                                Analyze My Compatibility
                            </a>
                        </div>
                    </div>
                </div>
            `;
        }
    </script>
</Layout>
