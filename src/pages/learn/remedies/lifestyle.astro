---
import Layout from '../../../components/Layout.astro';
const base = import.meta.env.BASE_URL;

const lifestyleGuide = {
    1: {
        favorable: {
            colors: ["Red", "Orange", "Golden", "Yellow"],
            days: ["Sunday"],
            directions: "East, North-East",
            foods: "Wheat, jaggery, saffron, almonds, warm spices",
            activities: "Leadership roles, government work, gold dealings, medicine",
            numbers: [1, 2, 3, 9]
        },
        avoid: {
            colors: ["Black", "Dark Blue", "Dark Grey"],
            days: ["Saturday"],
            conflicts: "Avoid partnerships with number 8",
            negativity: "Pride, ego, dominating behavior, overspending"
        },
        donations: "Wheat, jaggery, copper, ruby, red clothes on Sundays",
        fasting: "Fast on Sundays, eat after sunset",
        habits: ["Wake up early to see sunrise", "Practice Surya Namaskar", "Spend time in sunlight", "Meditate facing east"]
    },
    2: {
        favorable: {
            colors: ["White", "Cream", "Light Green", "Silver"],
            days: ["Monday"],
            directions: "North-West",
            foods: "Rice, milk, curd, white foods, coconut, cucumber",
            activities: "Nursing, teaching, hospitality, water-related business, dairy",
            numbers: [1, 2, 7, 9]
        },
        avoid: {
            colors: ["Red", "Dark colors"],
            days: ["Tuesday"],
            conflicts: "Avoid direct conflict with number 9",
