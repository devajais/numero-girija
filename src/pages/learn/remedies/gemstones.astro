---
import Layout from '../../../components/Layout.astro';
const base = import.meta.env.BASE_URL;

const gemstones = {
    1: {
        planet: "Sun",
        primary: "Ruby",
        alternatives: ["Red Garnet", "Red Spinel", "Red Tourmaline"],
        benefits: "Enhances leadership, confidence, vitality, and self-expression",
        howToWear: "Gold ring on ring finger or pendant, wear on Sunday morning",
        weight: "Minimum 3 carats"
    },
    2: {
        planet: "Moon",
        primary: "Pearl",
        alternatives: ["Moonstone", "White Coral"],
        benefits: "Improves emotional balance, intuition, relationships, and mental peace",
        howToWear: "Silver ring on little finger or pendant, wear on Monday morning",
        weight: "Minimum 5 carats"
    },
    3: {
        planet: "Jupiter",
        primary: "Yellow Sapphire",
        alternatives: ["Yellow Topaz", "Citrine"],
        benefits: "Brings wisdom, prosperity, creativity, and spiritual growth",
        howToWear: "Gold ring on index finger, wear on Thursday morning",
        weight: "Minimum 3 carats"
    },
    4: {
        planet: "Rahu",
        primary: "Hessonite (Gomed)",
        alternatives: ["Smoky Quartz", "Brown Zircon"],
        benefits: "Reduces confusion, enhances focus, improves mental clarity",
        howToWear: "Silver ring on middle finger, wear on Saturday evening",
        weight: "Minimum 5 carats"
    },
    5: {
        planet: "Mercury",
        primary: "Emerald",
        alternatives: ["Green Tourmaline", "Peridot", "Green Jade"],
        benefits: "Sharpens intellect, improves communication, business success",
        howToWear: "Gold ring on little finger, wear on Wednesday morning",
        weight: "Minimum 3 carats"
    },
    6: {
        planet: "Venus",
        primary: "Diamond",
        alternatives: ["White Sapphire", "White Zircon", "Opal"],
        benefits: "Attracts love, luxury, artistic talents, and material comforts",
        howToWear: "Silver or platinum ring on middle finger, wear on Friday morning",
        weight: "Minimum 1 carat (diamond) or 3 carats (alternatives)"
    },
    7: {
        planet: "Ketu",
        primary: "Cat's Eye (Lehsunia)",
        alternatives: ["Tiger's Eye", "Chrysoberyl"],
        benefits: "Enhances intuition, spiritual insight, and protection from negativity",
        howToWear: "Silver ring on middle finger, wear on Tuesday evening",
        weight: "Minimum 5 carats"
    },
    8: {
        planet: "Saturn",
        primary: "Blue Sapphire",
        alternatives: ["Amethyst", "Blue Topaz", "Lapis Lazuli"],
        benefits: "Brings discipline, removes obstacles, provides protection and success",
        howToWear: "Silver ring on middle finger, wear on Saturday morning (test first!)",
        weight: "Minimum 3 carats"
    },
    9: {
        planet: "Mars",
        primary: "Red Coral",
        alternatives: ["Carnelian", "Red Jasper"],
        benefits: "Increases courage, energy, determination, and physical strength",
        howToWear: "Gold or copper ring on ring finger, wear on Tuesday morning",
        weight: "Minimum 5 carats"
    }
};
---

<Layout title="Gemstones & Crystals - Numero Girija">
    <div class="breadcrumb">
        <a href={`${base}learn/`}>Learning Portal</a> / <a href={`${base}learn/remedies/`}>Remedies</a> / Gemstones
    </div>

    <div class="card">
        <h1 class="section-title">💎 Gemstones & Crystals for Each Number</h1>

        <div class="intro-section">
            <p>
                Gemstones are powerful tools in numerology for strengthening the vibrations of specific numbers. Each number is associated with a ruling planet, and wearing the corresponding gemstone can amplify positive traits and mitigate challenges.
            </p>
            <div class="warning-box">
                <h4>⚠️ Important Guidelines</h4>
                <ul>
                    <li>Consult a qualified numerologist or astrologer before wearing any gemstone</li>
                    <li>Always test gemstones for 3 days before permanent wearing</li>
                    <li>Blue Sapphire (Number 8) should be tested very carefully - it can have strong effects</li>
                    <li>Buy certified, natural gemstones from reputable sources</li>
                    <li>Cleanse and energize gemstones before wearing (sunlight/moonlight for 24 hours)</li>
                </ul>
            </div>
        </div>

        {Object.entries(gemstones).map(([num, data]) => (
            <div class="gemstone-card">
                <div class="gem-header">
                    <div class="gem-number">{num}</div>
                    <div class="gem-title">
                        <h3>Number {num} - {data.planet}</h3>
                        <p class="primary-gem">{data.primary}</p>
                    </div>
                </div>

                <div class="gem-content">
                    <div class="gem-section">
                        <h4>🌟 Benefits</h4>
                        <p>{data.benefits}</p>
                    </div>

                    <div class="gem-section">
                        <h4>💍 How to Wear</h4>
                        <p>{data.howToWear}</p>
                        <p class="weight-info">Recommended weight: {data.weight}</p>
                    </div>

                    <div class="gem-section">
                        <h4>🔄 Alternatives</h4>
                        <div class="alternatives">
                            {data.alternatives.map(alt => (
                                <span class="alt-gem">{alt}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        ))}

        <div class="tips-section">
            <h2>💡 Gemstone Care & Activation</h2>

            <div class="tip-card">
                <h4>Cleansing Your Gemstone</h4>
                <p>Before first use and monthly thereafter:</p>
                <ul>
                    <li>Soak in salt water for 3 hours</li>
                    <li>Rinse with clean water</li>
                    <li>Place in sunlight (for warm stones) or moonlight (for cool stones) for 24 hours</li>
                </ul>
            </div>

            <div class="tip-card">
                <h4>Energizing Ritual</h4>
                <p>On the recommended day (see each number above):</p>
                <ul>
                    <li>Wake up early, take a bath</li>
                    <li>Place gemstone in front of deity or sacred space</li>
                    <li>Chant the associated mantra 108 times</li>
                    <li>Wear the gemstone while continuing the mantra</li>
                </ul>
            </div>

            <div class="tip-card">
                <h4>When to Avoid Gemstones</h4>
                <ul>
                    <li>During pregnancy (consult doctor first)</li>
                    <li>If you feel discomfort, headaches, or negative dreams</li>
                    <li>During major illness or surgery</li>
                    <li>If the number's planet is already very strong in your chart</li>
                </ul>
            </div>
        </div>

        <div class="next-steps">
            <h3>Continue Learning</h3>
            <div class="next-links">
                <a href={`${base}learn/remedies/mantras/`} class="next-link">
                    <span>Next: Mantras & Chants →</span>
                </a>
                <a href={`${base}learn/numbers/missing/`} class="next-link">
                    <span>Missing Numbers Guide →</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        .breadcrumb {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .breadcrumb a {
            color: #6b3fa0;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .intro-section {
            margin-bottom: 30px;
        }

        .intro-section p {
            color: #444;
            font-size: 0.95rem;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .warning-box {
            background: linear-gradient(135deg, #fff5f5, #ffe5e5);
            border: 2px solid #ef4444;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
        }

        .warning-box h4 {
            color: #dc2626;
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 800;
        }

        .warning-box ul {
            color: #666;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-left: 20px;
        }

        .warning-box li {
            margin-bottom: 8px;
        }

        .gemstone-card {
            background: linear-gradient(135deg, #f9f5ff, #f0ebff);
            border: 2px solid #e8e8e8;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .gem-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e8e8e8;
        }

        .gem-number {
            background: linear-gradient(135deg, #2d1b69, #6b3fa0);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 900;
            flex-shrink: 0;
        }

        .gem-title h3 {
            color: #2d1b69;
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .primary-gem {
            color: #6b3fa0;
            font-size: 1rem;
            font-weight: 700;
        }

        .gem-content {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .gem-section h4 {
            color: #2d1b69;
            font-size: 0.9rem;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .gem-section p {
            color: #444;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-bottom: 6px;
        }

        .weight-info {
            color: #666;
            font-size: 0.8rem;
            font-style: italic;
        }

        .alternatives {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .alt-gem {
            background: white;
            border: 2px solid #6b3fa0;
            color: #6b3fa0;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .tips-section {
            margin-top: 40px;
        }

        .tips-section h2 {
            color: #2d1b69;
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .tip-card {
            background: white;
            border: 2px solid #e8e8e8;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .tip-card h4 {
            color: #6b3fa0;
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .tip-card p {
            color: #444;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .tip-card ul {
            color: #444;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-left: 20px;
        }

        .tip-card li {
            margin-bottom: 6px;
        }

        .next-steps {
            background: linear-gradient(135deg, #fff9e5, #ffedd5);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 24px;
            margin-top: 40px;
        }

        .next-steps h3 {
            color: #f59e0b;
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 16px;
        }

        .next-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .next-link {
            background: white;
            border: 2px solid #f59e0b;
            border-radius: 10px;
            padding: 14px 18px;
            text-decoration: none;
            color: #f59e0b;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.2s;
            text-align: center;
        }

        .next-link:hover {
            background: #f59e0b;
            color: white;
            transform: translateX(4px);
        }

        @media (min-width: 768px) {
            .next-links {
                flex-direction: row;
            }
        }
    </style>
</Layout>
