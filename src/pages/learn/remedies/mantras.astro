---
import Layout from '../../../components/Layout.astro';
const base = import.meta.env.BASE_URL;

const mantras = {
    1: {
        planet: "Sun",
        beej: "ॐ ह्रां ह्रीं ह्रौं सः सूर्याय नमः",
        transliteration: "Om Hraam Hreem Hraum Sah Suryaya Namah",
        gayatri: "ॐ भास्कराय विद्महे महाद्युतिकराय धीमहि तन्नो आदित्य प्रचोदयात्",
        gayatriTrans: "Om Bhaskaraya Vidmahe Mahadyutikaraya Dhimahi Tanno Aditya Prachodayat",
        simple: "ॐ सूर्याय नमः",
        simpleTrans: "Om Suryaya Namah",
        benefits: "Enhances leadership, confidence, vitality, father relationships, career success",
        bestTime: "Sunday morning during sunrise",
        count: "108 times or 11,000 times in 40 days"
    },
    2: {
        planet: "Moon",
        beej: "ॐ श्रां श्रीं श्रौं सः चन्द्राय नमः",
        transliteration: "Om Shraam Shreem Shraum Sah Chandraya Namah",
        gayatri: "ॐ पद्मद्वजाय विद्महे हेमरूपाय धीमहि तन्नो सोमः प्रचोदयात्",
        gayatriTrans: "Om Padmadvajaya Vidmahe Hemarupaya Dhimahi Tanno Somah Prachodayat",
        simple: "ॐ चन्द्राय नमः",
        simpleTrans: "Om Chandraya Namah",
        benefits: "Improves emotional balance, mother relationships, intuition, mental peace, creativity",
        bestTime: "Monday morning or during full moon",
        count: "108 times daily"
    },
    3: {
        planet: "Jupiter",
        beej: "ॐ ग्रां ग्रीं ग्रौं सः गुरवे नमः",
        transliteration: "Om Graam Greem Graum Sah Gurave Namah",
        gayatri: "ॐ वृषभद्वजाय विद्महे कृणिहस्ताय धीमहि तन्नो गुरुः प्रचोदयात्",
        gayatriTrans: "Om Vrishabadvajaya Vidmahe Krinihasthaya Dhimahi Tanno Guruh Prachodayat",
        simple: "ॐ गुरवे नमः",
        simpleTrans: "Om Gurave Namah",
        benefits: "Brings wisdom, prosperity, spiritual growth, marriage, children, education success",
        bestTime: "Thursday morning",
        count: "108 times daily or 19,000 times in 40 days"
    },
    4: {
        planet: "Rahu",
        beej: "ॐ भ्रां भ्रीं भ्रौं सः राहवे नमः",
        transliteration: "Om Bhraam Bhreem Bhraum Sah Rahave Namah",
        gayatri: "ॐ नागध्वजाय विद्महे पद्महस्ताय धीमहि तन्नो राहुः प्रचोदयात्",
        gayatriTrans: "Om Nagadhvajaya Vidmahe Padmahasthaya Dhimahi Tanno Rahuh Prachodayat",
        simple: "ॐ राहवे नमः",
        simpleTrans: "Om Rahave Namah",
        benefits: "Reduces confusion, removes obstacles, improves focus, protects from enemies",
        bestTime: "Saturday evening after sunset",
        count: "108 times daily or 18,000 times in 40 days"
    },
    5: {
        planet: "Mercury",
        beej: "ॐ ब्रां ब्रीं ब्रौं सः बुधाय नमः",
        transliteration: "Om Braam Breem Braum Sah Budhaya Namah",
        gayatri: "ॐ गजध्वजाय विद्महे शुकहस्ताय धीमहि तन्नो बुधः प्रचोदयात्",
        gayatriTrans: "Om Gajadhvajaya Vidmahe Shukhasthaya Dhimahi Tanno Budhah Prachodayat",
        simple: "ॐ बुधाय नमः",
        simpleTrans: "Om Budhaya Namah",
        benefits: "Sharpens intellect, improves communication, business success, education, speech",
        bestTime: "Wednesday morning",
        count: "108 times daily or 9,000 times in 40 days"
    },
    6: {
        planet: "Venus",
        beej: "ॐ द्रां द्रीं द्रौं सः शुक्राय नमः",
        transliteration: "Om Draam Dreem Draum Sah Shukraya Namah",
        gayatri: "ॐ अश्वध्वजाय विद्महे धनुर्हस्ताय धीमहि तन्नो शुक्रः प्रचोदयात्",
        gayatriTrans: "Om Ashvadhvajaya Vidmahe Dhanurhasthaya Dhimahi Tanno Shukrah Prachodayat",
        simple: "ॐ शुक्राय नमः",
        simpleTrans: "Om Shukraya Namah",
        benefits: "Attracts love, marriage, luxury, artistic talents, vehicles, material comforts",
        bestTime: "Friday morning",
        count: "108 times daily or 16,000 times in 40 days"
    },
    7: {
        planet: "Ketu",
        beej: "ॐ स्रां स्रीं स्रौं सः केतवे नमः",
        transliteration: "Om Sraam Sreem Sraum Sah Ketave Namah",
        gayatri: "ॐ अश्वध्वजाय विद्महे शूलहस्ताय धीमहि तन्नो केतुः प्रचोदयात्",
        gayatriTrans: "Om Ashvadhvajaya Vidmahe Shulahasthaya Dhimahi Tanno Ketuh Prachodayat",
        simple: "ॐ केतवे नमः",
        simpleTrans: "Om Ketave Namah",
        benefits: "Enhances intuition, spiritual insight, moksha, removes negativity, psychic abilities",
        bestTime: "Tuesday evening",
        count: "108 times daily or 7,000 times in 40 days"
    },
    8: {
        planet: "Saturn",
        beej: "ॐ प्रां प्रीं प्रौं सः शनैश्चराय नमः",
        transliteration: "Om Praam Preem Praum Sah Shanaischaraya Namah",
        gayatri: "ॐ काकध्वजाय विद्महे खड्गहस्ताय धीमहि तन्नो मन्दः प्रचोदयात्",
        gayatriTrans: "Om Kakadhvajaya Vidmahe Khadgahasthaya Dhimahi Tanno Mandah Prachodayat",
        simple: "ॐ शनैश्चराय नमः",
        simpleTrans: "Om Shanaischaraya Namah",
        benefits: "Removes obstacles, brings discipline, justice, longevity, property, karma balance",
        bestTime: "Saturday morning",
        count: "108 times daily or 23,000 times in 40 days"
    },
    9: {
        planet: "Mars",
        beej: "ॐ क्रां क्रीं क्रौं सः भौमाय नमः",
        transliteration: "Om Kraam Kreem Kraum Sah Bhaumaya Namah",
        gayatri: "ॐ वीरध्वजाय विद्महे विघ्नहस्ताय धीमहि तन्नो भौमः प्रचोदयात्",
        gayatriTrans: "Om Veeradhvajaya Vidmahe Vighnahasthaya Dhimahi Tanno Bhaumah Prachodayat",
        simple: "ॐ मंगलाय नमः",
        simpleTrans: "Om Mangalaya Namah",
        benefits: "Increases courage, energy, property, siblings harmony, removes blood disorders",
        bestTime: "Tuesday morning",
        count: "108 times daily or 10,000 times in 40 days"
    }
};
---

<Layout title="Mantras & Chants - Numero Girija">
    <div class="breadcrumb">
        <a href={`${base}learn/`}>Learning Portal</a> / <a href={`${base}learn/remedies/`}>Remedies</a> / Mantras
    </div>

    <div class="card">
        <h1 class="section-title">🕉️ Mantras & Chants for Each Number</h1>

        <div class="intro-section">
            <p>
                Mantras are sacred sound vibrations that align you with planetary energies. Chanting mantras for your missing or weak numbers can strengthen their positive influence in your life. Each number corresponds to a planetary deity with specific mantras.
            </p>

            <div class="guide-box">
                <h4>📿 How to Chant Mantras Properly</h4>
                <ol>
                    <li><strong>Time:</strong> Chant during the recommended day and time for maximum benefit</li>
                    <li><strong>Place:</strong> Clean, quiet space facing the deity or east direction</li>
                    <li><strong>Preparation:</strong> Take bath, wear clean clothes, light a lamp/incense</li>
                    <li><strong>Posture:</strong> Sit comfortably with straight spine, use a mat or cushion</li>
                    <li><strong>Focus:</strong> Close eyes or gaze at deity image, concentrate on the planet</li>
                    <li><strong>Count:</strong> Use a mala (108 beads) to count repetitions</li>
                    <li><strong>Consistency:</strong> Daily practice is more powerful than occasional long sessions</li>
                    <li><strong>Faith:</strong> Chant with devotion, belief, and positive intention</li>
                </ol>
            </div>
        </div>

        {Object.entries(mantras).map(([num, data]) => (
            <div class="mantra-card">
                <div class="mantra-header">
                    <div class="mantra-number">{num}</div>
                    <div class="mantra-title">
                        <h3>Number {num} - {data.planet}</h3>
                    </div>
                </div>

                <div class="mantra-content">
                    <div class="mantra-section beej-section">
                        <h4>🔱 Beej Mantra (Seed Mantra - Most Powerful)</h4>
                        <div class="sanskrit">{data.beej}</div>
                        <div class="transliteration">{data.transliteration}</div>
                    </div>

                    <div class="mantra-section">
                        <h4>🌟 Gayatri Mantra</h4>
                        <div class="sanskrit">{data.gayatri}</div>
                        <div class="transliteration">{data.gayatriTrans}</div>
                    </div>

                    <div class="mantra-section">
                        <h4>✨ Simple Mantra (For Beginners)</h4>
                        <div class="sanskrit">{data.simple}</div>
                        <div class="transliteration">{data.simpleTrans}</div>
                    </div>

                    <div class="benefits-section">
                        <h4>💫 Benefits</h4>
                        <p>{data.benefits}</p>
                    </div>

                    <div class="practice-info">
                        <div class="info-item">
                            <strong>⏰ Best Time:</strong> {data.bestTime}
                        </div>
                        <div class="info-item">
                            <strong>🔢 Repetitions:</strong> {data.count}
                        </div>
                    </div>
                </div>
            </div>
        ))}

        <div class="additional-practices">
            <h2>🙏 Additional Spiritual Practices</h2>

            <div class="practice-card">
                <h4>Daily Sankalp (Intention Setting)</h4>
                <p>Before starting mantra chanting, set your intention:</p>
                <div class="sanskrit-text">"ॐ विष्णुः ॐ तत्सत् श्री गोविन्द गोविन्द गोविन्द"</div>
                <p class="description">Then state your wish mentally or aloud in your own words with pure heart.</p>
            </div>

            <div class="practice-card">
                <h4>Japa Mala (Prayer Beads)</h4>
                <ul>
                    <li><strong>Rudraksha Mala:</strong> All-purpose, especially for Sun, Mars, Saturn</li>
                    <li><strong>Crystal/Sphatik Mala:</strong> Moon, Venus, Mercury</li>
                    <li><strong>Tulsi Mala:</strong> All planets, general spiritual practice</li>
                    <li><strong>Sandalwood Mala:</strong> Venus, Moon, peaceful vibrations</li>
                </ul>
            </div>

            <div class="practice-card">
                <h4>Completion Ritual (After 40 Days)</h4>
                <ol>
                    <li>Perform the final 108 chants with extra devotion</li>
                    <li>Offer flowers, fruits, or sweets to the deity</li>
                    <li>Light a ghee lamp and incense</li>
                    <li>Donate items related to the planet (see lifestyle guide)</li>
                    <li>Thank the divine for blessings received</li>
                </ol>
            </div>

            <div class="practice-card">
                <h4>Combining with Other Remedies</h4>
                <p>For maximum benefit, combine mantra practice with:</p>
                <ul>
                    <li>Wearing the appropriate gemstone</li>
                    <li>Following lifestyle dos and don'ts</li>
                    <li>Observing fasts on the planetary day</li>
                    <li>Charity and donations specific to the planet</li>
                </ul>
            </div>
        </div>

        <div class="next-steps">
            <h3>Continue Learning</h3>
            <div class="next-links">
                <a href={`${base}learn/remedies/lifestyle/`} class="next-link">
                    <span>Next: Lifestyle Guidance →</span>
                </a>
                <a href={`${base}learn/remedies/gemstones/`} class="next-link">
                    <span>Gemstones Guide →</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        .breadcrumb {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .breadcrumb a {
            color: #6b3fa0;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .intro-section {
            margin-bottom: 30px;
        }

        .intro-section p {
            color: #444;
            font-size: 0.95rem;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .guide-box {
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            border: 2px solid #10b981;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
        }

        .guide-box h4 {
            color: #059669;
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 800;
        }

        .guide-box ol {
            color: #444;
            font-size: 0.85rem;
            line-height: 1.7;
            margin-left: 20px;
        }

        .guide-box li {
            margin-bottom: 8px;
        }

        .guide-box strong {
            color: #059669;
        }

        .mantra-card {
            background: linear-gradient(135deg, #fef9e7, #fef3c7);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .mantra-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f59e0b;
        }

        .mantra-number {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 900;
            flex-shrink: 0;
        }

        .mantra-title h3 {
            color: #92400e;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .mantra-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .mantra-section {
            background: white;
            border-radius: 12px;
            padding: 16px;
        }

        .beej-section {
            border: 2px solid #f59e0b;
        }

        .mantra-section h4 {
            color: #92400e;
            font-size: 0.9rem;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .sanskrit {
            font-size: 1.2rem;
            color: #78350f;
            font-weight: 700;
            margin-bottom: 8px;
            line-height: 1.8;
            text-align: center;
        }

        .transliteration {
            color: #666;
            font-size: 0.9rem;
            font-style: italic;
            text-align: center;
        }

        .benefits-section p {
            color: #444;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .practice-info {
            display: grid;
            gap: 12px;
        }

        .info-item {
            background: white;
            padding: 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            color: #444;
        }

        .info-item strong {
            color: #92400e;
        }

        .additional-practices {
            margin-top: 40px;
        }

        .additional-practices h2 {
            color: #2d1b69;
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .practice-card {
            background: white;
            border: 2px solid #e8e8e8;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .practice-card h4 {
            color: #6b3fa0;
            font-size: 1rem;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .practice-card p {
            color: #444;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .practice-card ul,
        .practice-card ol {
            color: #444;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-left: 20px;
        }

        .practice-card li {
            margin-bottom: 6px;
        }

        .sanskrit-text {
            background: linear-gradient(135deg, #f9f5ff, #f0ebff);
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-size: 1.1rem;
            color: #6b3fa0;
            font-weight: 700;
            margin: 12px 0;
        }

        .description {
            font-size: 0.85rem;
            color: #666;
            font-style: italic;
        }

        .next-steps {
            background: linear-gradient(135deg, #fff9e5, #ffedd5);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 24px;
            margin-top: 40px;
        }

        .next-steps h3 {
            color: #f59e0b;
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 16px;
        }

        .next-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .next-link {
            background: white;
            border: 2px solid #f59e0b;
            border-radius: 10px;
            padding: 14px 18px;
            text-decoration: none;
            color: #f59e0b;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.2s;
            text-align: center;
        }

        .next-link:hover {
            background: #f59e0b;
            color: white;
            transform: translateX(4px);
        }

        @media (min-width: 768px) {
            .next-links {
                flex-direction: row;
            }
        }
    </style>
</Layout>
